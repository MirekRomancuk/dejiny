# Copy to .env.deploy (gitignored) and fill in the FTP credentials.
# Used only by scripts/deploy-ftp.sh - never committed.

FTP_HOST=ftp.example.com
FTP_USER=your-ftp-user
# Prefer the Base64 form so shell metacharacters in the password remain safe.
# Generate it locally; this file is only a template and must never contain a real secret.
FTP_PASS_B64=
# Plain-text fallback (leave empty when FTP_PASS_B64 is set).
FTP_PASS=
# Remote directory inside the hosting account. This must match the document root
# configured for the target domain or subdomain in the hosting control panel.
FTP_REMOTE_DIR=/path/to/document-root
# Required only when FTP_REMOTE_DIR is exactly /www.
FTP_ALLOW_PRODUCTION_ROOT=no
